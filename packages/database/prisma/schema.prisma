generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String          @id @default(cuid())
  name           String
  defaultProfile String          @default("dev")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profiles       Profile[]
  scopes         Scope[]
  variables      Variable[]
  values         VariableValue[]

  @@map("projects")
}

model Profile {
  id        String          @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values    VariableValue[]

  @@unique([projectId, name])
  @@map("profiles")
}

model Scope {
  id        String          @id @default(cuid())
  projectId String
  name      String
  path      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables ScopeVariable[]
  values    VariableValue[]

  @@unique([projectId, name])
  @@map("scopes")
}

model Variable {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      String          @default("string")
  required  Boolean         @default(false)
  secret    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopes    ScopeVariable[]
  values    VariableValue[]

  @@unique([projectId, name])
  @@map("variables")
}

model ScopeVariable {
  id         String   @id @default(cuid())
  scopeId    String
  variableId String
  createdAt  DateTime @default(now())
  scope      Scope    @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  variable   Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@unique([scopeId, variableId])
  @@map("scope_variables")
}

model VariableValue {
  id         String   @id @default(cuid())
  projectId  String
  profileId  String
  variableId String
  scopeId    String?
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  variable   Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  scope      Scope?   @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([profileId, variableId, scopeId])
  @@index([projectId, profileId])
  @@map("variable_values")
}
