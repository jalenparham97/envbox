    "typecheck": "tsc --noEmit",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@envbox/utils": "workspace:*"
  },
  "devDependencies": {
    "@envbox/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "oxlint": "latest",
    "typescript": "^6.0.0"
  }
}